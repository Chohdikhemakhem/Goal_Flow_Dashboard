ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://microcred:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/microcred
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_VALUE
JWT_ALGORITHM=HS256
JWT_ISSUER=metrics-gp-mcr
JWT_AUDIENCE=metrics-gp-mcr-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_COOKIE_NAME=microcred_access
REFRESH_COOKIE_NAME=microcred_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
LOGIN_MAX_ATTEMPTS=6
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_EXPIRY_DAYS=40
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
BONUS_MODULE_ACTIVE=false
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_FULL_NAME=Platform Super Admin
